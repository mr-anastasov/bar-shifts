  "sops": [
    {
      "title": "Gin Tonic",
      "steps": [
        "Fill cup with ice till half",
        "Pour **50ml gin** into cup",
        "Add **squeeze of lemon concentrate** (about 10-15ml)",
        "Pour tonic till almost full",
        "Drop in **lemon wedge**",
        "Place **fresh mint sprig** standing upright in cup"
      ]
    },
    {
      "title": "Cuba Libre",
      "steps": [
        "Fill cup with ice till half",
        "Drop in **lime wedge** press with tool",
        "Pour **50ml rum** into ice-filled 400ml cup",
        "Pour Coke till almost full"
      ]
    },
    {
      "title": "Whiskey Coke",
      "steps": [
        "Pour **50ml whiskey** into 400ml cup with **large ice cube(s)**",
        "Pour entire **200ml Coke can** into cup",
        "Stir gently",
        "Add **2–3 dashes of bitters** on top",
        "Place **dehydrated orange wheel** on top"
      ]
    }
